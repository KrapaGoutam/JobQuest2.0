# JobQuest 2.0 — environment variable NAMES (M1B, Auth Option B). Copy to .env.local (gitignored).
# NEVER commit real values. NEVER prefix a server secret with VITE_.

# --- Browser-safe (bundled into the web app) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server only (Node API / Vercel Functions) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Private ES256 JWK (single-line JSON) whose public half the Supabase project trusts.
# Signs JobQuest access tokens. Server only: never in the browser, Git, the DB or logs.
JQ_JWT_PRIVATE_JWK=
# JQ_JWT_ISSUER=jobquest-api
APP_ORIGINS=http://localhost:5173

# --- Optional session / hashing overrides (defaults in apps/api/src/env.ts) ---
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=2592000
# SESSION_MAX_SECONDS=2592000
# PASSWORD_ARGON2_MEMORY_KIB=19456
# PASSWORD_ARGON2_TIME_COST=2
# PASSWORD_ARGON2_PARALLELISM=1

# --- Optional rate-limit overrides (defaults = Gate 03 values) ---
# RATE_LIMIT_STORE=db
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15
# LOGIN_IP_MAX_PER_15M=20
# REGISTER_IP_MAX_PER_HOUR=3
# RECOVERY_MAX_FAILURES=3
# RECOVERY_LOCK_MINUTES=60
# RECOVERY_IP_MAX_PER_HOUR=10
# PASSWORD_CHANGE_MAX_PER_HOUR=3

# --- Tooling only (CLI migrations + evidence queries); never deployed ---
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=

# Local stack: `pnpm local:key && supabase start && pnpm local:env` writes .env.m1b-local.
