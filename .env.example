# JobQuest 2.0 — environment variable NAMES (M1). Copy to .env.local (gitignored) and fill in.
# NEVER commit real values. NEVER prefix a server secret with VITE_.

# --- Browser-safe (bundled into the web app) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server only (Node façade / Vercel Functions) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
APP_ORIGINS=http://localhost:5173

# --- Tooling only (CLI migrations + M1 evidence queries); never deployed ---
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=

# --- Optional rate-limit overrides (defaults = Gate 03 values) ---
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15
# LOGIN_IP_MAX_PER_15M=20
# REGISTER_IP_MAX_PER_HOUR=3
# RECOVERY_MAX_FAILURES=3
# RECOVERY_LOCK_MINUTES=60
# RECOVERY_IP_MAX_PER_HOUR=10
