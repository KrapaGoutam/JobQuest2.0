{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "skipLibCheck": true,
    "types": ["chrome"]
  },
  "include": ["api/**/*.js", "background.js", "options.js", "popup.js", "sidepanel.js", "sidepanel-logic.js", "extractors/**/*.js"]
}
